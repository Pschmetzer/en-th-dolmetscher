<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Nur genutzt, wenn „Im Hintergrund weiter zuhören“ eingeschaltet ist. -->
	<key>UIBackgroundModes</key>
	<array>
		<string>audio</string>
	</array>
	<!-- Zwei-Geräte-Modus (Runde 34): Suche nach dem zweiten iPhone im lokalen Netz. Nur Text, nichts geht ins Internet. Der Beschreibungstext steht in den Build-Einstellungen (INFOPLIST_KEY_NSLocalNetworkUsageDescription). -->
	<key>NSBonjourServices</key>
	<array>
		<string>_dolm-pair._tcp</string>
		<string>_dolm-pair._udp</string>
	</array>
</dict>
</plist>
