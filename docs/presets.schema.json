{
 "$schema": "http://json-schema.org/draft-07/schema#",
 "$id": "presets.schema.json",
 "title": "Phrasenpaket (presets/*.json)",
 "description": "Entspricht presets.validate(). In VS Code: Einstellung json.schemas auf presets/*.json mit dieser Datei. Siehe docs/PRESETS.md.",
 "type": "object",
 "required": [
  "id",
  "names",
  "style"
 ],
 "additionalProperties": false,
 "definitions": {
  "pair": {
   "type": "object",
   "required": [
    "en",
    "th"
   ],
   "additionalProperties": true,
   "properties": {
    "en": {
     "type": "string",
     "minLength": 1,
     "maxLength": 200
    },
    "th": {
     "type": "string",
     "minLength": 1,
     "maxLength": 200
    },
    "critical": {
     "type": "boolean"
    }
   }
  }
 },
 "properties": {
  "id": {
   "type": "string",
   "pattern": "^[a-z0-9_-]{1,32}$"
  },
  "names": {
   "type": "object",
   "required": [
    "de",
    "en",
    "th"
   ],
   "properties": {
    "de": {
     "type": "string",
     "minLength": 1,
     "maxLength": 40
    },
    "en": {
     "type": "string",
     "minLength": 1,
     "maxLength": 40
    },
    "th": {
     "type": "string",
     "minLength": 1,
     "maxLength": 40
    }
   }
  },
  "style": {
   "enum": [
    "casual",
    "neutral",
    "polite"
   ]
  },
  "polite": {
   "enum": [
    "krub",
    "ka"
   ]
  },
  "voice": {
   "type": "object",
   "additionalProperties": false,
   "properties": {
    "en": {
     "type": "string",
     "maxLength": 64
    },
    "th": {
     "type": "string",
     "maxLength": 64
    }
   }
  },
  "note": {
   "type": "object",
   "required": [
    "de",
    "en"
   ],
   "additionalProperties": false,
   "properties": {
    "de": {
     "type": "string",
     "minLength": 1,
     "maxLength": 500
    },
    "en": {
     "type": "string",
     "minLength": 1,
     "maxLength": 500
    },
    "th": {
     "type": "string",
     "minLength": 1,
     "maxLength": 500
    }
   }
  },
  "glossary": {
   "type": "array",
   "maxItems": 100,
   "items": {
    "$ref": "#/definitions/pair"
   }
  },
  "phrases": {
   "type": "array",
   "maxItems": 50,
   "items": {
    "$ref": "#/definitions/pair"
   }
  },
  "hotwords": {
   "type": "array",
   "items": {
    "type": "string",
    "minLength": 1,
    "maxLength": 60
   }
  },
  "llm_hint": {
   "type": "string",
   "minLength": 1
  }
 }
}