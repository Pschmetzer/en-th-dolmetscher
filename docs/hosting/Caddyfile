# Caddy: HTTPS und Zertifikate kommen automatisch (siehe docs/WEB-HOSTING.md). Domain und Pfad anpassen.
example.org {
	root * /var/www/dolmetscher
	file_server
	encode zstd gzip

	header {
		Permissions-Policy "microphone=(self), camera=(), geolocation=()"
		Referrer-Policy "no-referrer"
		Cross-Origin-Opener-Policy "same-origin"
		X-Content-Type-Options "nosniff"
		Content-Security-Policy "frame-ancestors 'none'"
	}
	@neu path / /index.html /sw.js
	header @neu Cache-Control "no-cache"
	@manifest path /manifest.webmanifest
	header @manifest Content-Type "application/manifest+json"
}
