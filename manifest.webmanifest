{
  "name": "Dolmetscher EN⇄TH (Web Lite)",
  "short_name": "Dolmetscher",
  "description": "Speak, translate, read aloud – phrasebook and show cards for Thailand, offline. Sprechen, übersetzen, vorlesen.",
  "lang": "de",
  "dir": "ltr",
  "id": "./",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "display_override": [
    "standalone",
    "minimal-ui"
  ],
  "orientation": "any",
  "categories": [
    "travel",
    "utilities",
    "education"
  ],
  "background_color": "#f6f7f9",
  "theme_color": "#1d4ed8",
  "icons": [
    {
      "src": "icon.svg",
      "sizes": "any",
      "type": "image/svg+xml",
      "purpose": "any"
    },
    {
      "src": "icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "icon-maskable-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "maskable"
    },
    {
      "src": "icon-maskable-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "shortcuts": [
    {
      "name": "Taxi",
      "short_name": "Taxi",
      "url": "./#preset=taxi",
      "icons": [
        {
          "src": "icon-192.png",
          "sizes": "192x192",
          "type": "image/png"
        }
      ]
    },
    {
      "name": "Arzt",
      "short_name": "Arzt",
      "url": "./#preset=doctor",
      "icons": [
        {
