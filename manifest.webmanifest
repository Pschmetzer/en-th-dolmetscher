      "url": "./#preset=police",
      "icons": [
        {
          "src": "icon-192.png",
          "sizes": "192x192",
          "type": "image/png"
        }
      ]
    },
    {
      "name": "Satzbuch",
      "short_name": "Satzbuch",
      "url": "./#preset=travel",
      "icons": [
        {
          "src": "icon-192.png",
